# ==========================================================================
#  .gitignore — 智能问答助手
#
#  忽略原则：凡是【能重新生成】的，或者【含密钥】的，都不进版本库。
#     可重新生成：虚拟环境、缓存、向量索引、SQLite 库、日志
#     含密钥：    .env
#  知识库 db/data.json 是人工维护的真实内容，**要**提交，见文件末尾的例外。
# ==========================================================================

# --------------------------------------------------------------------------
# 密钥与本地配置（最重要）
#
# .env 里有真实 API Key，绝对不要提交。
#
# 注意：.env 同时承担了「密钥」和「可调参数」两种角色（阈值、开关等）。
# 那些参数是随知识库变化的调优结果，属于本机状态，本来也不该跟着仓库走。
# 别人 clone 后照 .env.example 复制一份即可。
#
# 用 *.env 而不是 .env，顺带挡住 .env.local / .env.prod 这类派生文件。
# 如果你另有 *.env.example 模板，本文件末尾有例外放行。
# --------------------------------------------------------------------------
*.env

# --------------------------------------------------------------------------
# 虚拟环境
#   项目自带的 venv 约 158 MB / 4000+ 文件，提交进去会严重拖累仓库。
#   依赖用 requirements.txt 复现即可。
# --------------------------------------------------------------------------
venv/
env/
ENV/
.venv/
virtualenv/

# --------------------------------------------------------------------------
# Python 缓存与构建产物
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
pip-wheel-metadata/
.installed.cfg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --------------------------------------------------------------------------
# 向量索引（可重新生成）
#   由 build_index.py 依据 db/data.json + embedding 接口生成。
#   索引与 embedding 模型是绑定的：换模型旧索引就作废，所以不适合入库。
#   注意：不要在这里写 index/ —— 那会连带忽略整个目录。
# --------------------------------------------------------------------------
index/*.index
*.index
*.faiss

# --------------------------------------------------------------------------
# 数据库与日志
#   k_database.db / logs.db 是运行时产生的 SQLite 文件（见 db/database.py）。
#   真正的知识内容在 db/data.json，那个要提交，别被下面的 *.db 误伤。
# --------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/

# --------------------------------------------------------------------------
# 评测与测试的临时产物
#   评测脚本用 --json 输出的存档默认只是本地对比用。
#   如果你想留存某次基线做回归对比，用 `git add -f 文件名` 强制加进来。
# --------------------------------------------------------------------------
baseline_*.json
tests/baseline_*.json
_sweep.json
*.png
*.tmp

# 离线自检生成的临时索引目录
_selftest_idx/

# --------------------------------------------------------------------------
# 编辑器 / IDE / 操作系统
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 本机公钥导出（公钥不是秘密，但没必要入库；私钥永远不要导出）
ssh_public_key.txt

# --------------------------------------------------------------------------
# 例外：以下内容必须进版本库
# --------------------------------------------------------------------------

# 知识库正文 —— 人工维护的核心内容
!db/data.json

# 依赖清单
!requirements.txt
!requirement.txt

# 配置模板（无密钥，供他人复制成 .env）
!.env.example
!*.env.example

# 前端静态资源（源码，不是构建产物）
!frontend/
!frontend/**
