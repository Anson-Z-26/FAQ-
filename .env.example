# ==========================================================================
#  配置模板 —— 复制成 .env 后填入自己的值
#
#      cp .env.example .env        (Linux / macOS)
#      copy .env.example .env      (Windows)
#
#  .env 已被 .gitignore 忽略，不要提交真实密钥。
# ==========================================================================

# --------------------------------------------------------------------------
# 模型服务（必填）
#   本项目的 embedding、rerank、以及后续的大模型生成都走同一套
#   OpenAI 兼容接口，一个 Key 就够。
# --------------------------------------------------------------------------
DASHSCOPE_API_KEY=在这里填入你的API Key

# 填 base_url 或完整接口地址都行，程序会自动补 /embeddings
EMBEDDING_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# v3 实测优于 v4（可用 eval_retrieval.py 复测）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# --------------------------------------------------------------------------
# 检索参数（选填，有默认值）
#
# 阈值是按【实测分数分布】定的，不是通用值。
# 换 embedding 模型或大改知识库后，分数的绝对尺度会变，必须重新扫：
#   比较「有效查询的最低分」和「无关查询的最高分」，阈值取两者之间。
# 扫描方法见 eval_retrieval.py 与项目说明。
# --------------------------------------------------------------------------
TOP_K=5
SCORE_THRESHOLD=0.55
ANSWER_SCORE_THRESHOLD=0.48
RECALL_K=10
ANSWER_INDEX_ENABLED=true

# 一条知识有多个问法变体（aliases）时，同一知识会占多个索引行。
# 召回时按此倍数多取行，按知识条目去重后再截到 RECALL_K 个条目，
# 否则去重后候选数会明显不足。取 1 等于不超取。
RECALL_OVERFETCH=3

# 索引清单（index/manifest.json）校验不通过时是否拒绝启动。
# 默认 true：宁可起不来，也不要带着错位的索引对外返回错误答案。
# 只有在校验本身误报时才临时设 false，不要长期关闭。
STRICT_INDEX_CHECK=true

# --------------------------------------------------------------------------
# rerank（选填）
#   开启后用 cross-encoder 精排，并作为「该不该回答」的门槛。
#   代价：每次查询多约 0.5 秒网络往返。
# --------------------------------------------------------------------------
RERANK_ENABLED=true
RERANK_URL=https://maas.qianwenaiapi.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
# 绝对门槛：与向量相似度不同源，必须用独立阈值。回答「这条够不够格被回答」。
RERANK_SCORE_THRESHOLD=0.40
# 相对门槛：只保留分数 >= 最佳分 × 该比例的条目。回答「这条和最佳答案差多少」。
# rerank 分数是本次请求内的相对分数（官方明确说明不可跨请求比较），
# 所以用相对比例比固定绝对阈值更贴合语义。设为 0 可关闭。
# 实测取 0.6 可把上下文从平均 3.7 条压到 2.2 条（知识 token -41%），召回不变。
RERANK_RELATIVE_RATIO=0.6
# 保底条数：即使后面全被相对截断，也至少保留这么多条（前提是过了绝对门槛）
RERANK_MIN_KEEP=1

# --------------------------------------------------------------------------
# 大模型生成（选填）
#   开启后 /ask 会把检索到的材料交给大模型，生成自然语言回答；
#   关闭时只返回知识原文，不产生生成费用。
#   与 embedding / rerank 共用同一个 API Key。
# --------------------------------------------------------------------------
LLM_ENABLED=true
LLM_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MAX_TOKENS=800
# RAG 需要稳定复述材料，温度调低，别让它发挥
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
# 关闭深度思考。该模型默认开启思考模式，会先输出一大段思维链：
#   默认      约 2.2s / 63 个 reasoning token
#   关闭后    约 1.6s / 0 个 reasoning token
# RAG 的材料和问题都摆在明面上，不需要多步推理。
LLM_DISABLE_THINKING=true

# --------------------------------------------------------------------------
# 多轮对话（选填）
#   追问里的指代会先被改写成独立问题再检索，否则「它有空调吗」这类
#   离开上文就检索不到。改写会多一次模型调用，约多 0.9 秒。
# --------------------------------------------------------------------------
# 保留最近多少轮历史交给模型
MAX_TURNS=5
# 会话空闲多久后过期（秒）。当前会话存在内存里，重启即丢。
SESSION_TTL_SECONDS=1800

# --------------------------------------------------------------------------
# 前端
# --------------------------------------------------------------------------
UI_TITLE=智能问答助手
# 「查询地图」跳转按钮的地址。留空 = 按钮置灰并提示未配置。
# 例（高德搜索）：https://uri.amap.com/search?keyword=西安电子科技大学
QUERY_MAP_URL=

# 如需自定义路径（默认 index/ 与 db/data.json），取消注释：
# INDEX_DIR=index
# KNOWLEDGE_PATH=db/data.json
# UI_STATIC_DIR=frontend
